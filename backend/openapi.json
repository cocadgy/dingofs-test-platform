  "components": {
    "schemas": {
      "DraftInput": {
        "properties": {
          "base_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Base Revision"
          },
          "mode": {
            "type": "string",
            "enum": [
              "yaml",
              "form"
            ],
            "title": "Mode"
          },
          "yaml_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Yaml Text"
          },
          "field_updates": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Updates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_revision",
          "mode"
        ],
        "title": "DraftInput"
      },
      "DraftResponse": {
        "properties": {
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "yaml_text": {
            "type": "string",
            "title": "Yaml Text"
          },
          "document_kind": {
            "type": "string",
            "enum": [
              "platform-environment",
              "dingo-topology"
            ],
            "title": "Document Kind"
          },
          "form_values": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Form Values"
          },
          "validation": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Validation"
          }
        },
        "type": "object",
        "required": [
          "revision",
          "yaml_text",
          "document_kind",
          "form_values",
          "validation"
        ],
        "title": "DraftResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Revision": {
        "properties": {
          "base_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Base Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_revision"
        ],
        "title": "Revision"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
