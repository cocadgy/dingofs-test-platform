# Copy to .env and set a unique password (URL-safe letters and digits).
POSTGRES_PASSWORD=replace-with-a-long-random-password
PLATFORM_COOKIE_SECURE=false
PLATFORM_HTTP_PORT=58080

# Persistent Fernet key, generated once; required to save/use machine SSH passwords.
PLATFORM_CREDENTIAL_ENCRYPTION_KEY=

# Bounded cluster discovery/status reads (seconds, bytes, concurrent actions per machine).
PLATFORM_CLUSTER_DISCOVERY_TIMEOUT=60
PLATFORM_CLUSTER_STATUS_TIMEOUT=120
PLATFORM_CLUSTER_CONTROL_TIMEOUT=300
PLATFORM_CLUSTER_MAX_BYTES=2097152
PLATFORM_CLUSTER_MACHINE_CONCURRENCY=2
PLATFORM_CLUSTER_AUTH_SECONDS=300
PLATFORM_CLUSTER_DISCOVERY_SECONDS=900

# Web SSH/log session deadlines and concurrency (single API instance).
PLATFORM_REMOTE_CONNECT_TIMEOUT=15
PLATFORM_REMOTE_READ_TIMEOUT=30
PLATFORM_REMOTE_DOWNLOAD_TIMEOUT=120
PLATFORM_REMOTE_IDLE_SECONDS=900
PLATFORM_REMOTE_LIFETIME_SECONDS=7200
PLATFORM_REMOTE_MACHINE_LIMIT=4
PLATFORM_REMOTE_TERMINAL_LIMIT=2
PLATFORM_REMOTE_FOLLOW_LIMIT=4

# 每次资源操作总超时（秒，10–3600）
PLATFORM_RESOURCE_OPERATION_TIMEOUT=600
